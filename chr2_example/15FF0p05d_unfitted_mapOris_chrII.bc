//S. cerevisiae whole genome replication model
L = 813; //length of S. cerevisiae chrII in kilobases
fast = 100000; //fast rate
v = 1.4; //fork velocity in kilobases per minute
           
//process definitions

FF[] = {@factor![0],1}.{dwell,0.05}.FF[];

ORI[i,fire,ori] = {@factor?[0],fire}.(FL[i,ori]||FR[i,ori])
              + {ch?[i],fast};
FR[i,ori] = {ch![i],fast}.[i < L] -> {~ch?[i+1],v}.FR[i+1,ori];
FL[i,ori] = {ch![i],fast}.[i > 0] -> {~ch?[i-1],v}.FL[i-1,ori];

//initial processes in the system
ORI[0,0.00213,0] || ORI[6,0.00199,6] || ORI[29,0.00220,29] || ORI[38,0.00220,38] || ORI[63,0.00232,63] || ORI[72,0.00219,72] || ORI[93,0.00237,93] || ORI[143,0.00216,143] || ORI[170,0.00252,170] || ORI[177,0.00269,177] || ORI[187,0.00262,187] || ORI[198,0.00288,198] || ORI[209,0.00302,209] || ORI[237,0.00375,237] || ORI[255,0.00336,255] || ORI[259,0.00274,259] || ORI[283,0.00201,283] || ORI[326,0.00238,326] || ORI[378,0.00241,378] || ORI[389,0.00258,389] || ORI[407,0.00304,407] || ORI[417,0.00271,417] || ORI[441,0.00178,441] || ORI[486,0.00269,486] || ORI[498,0.00240,498] || ORI[504,0.00222,504] || ORI[517,0.00217,517] || ORI[539,0.00231,539] || ORI[548,0.00189,548] || ORI[583,0.00235,583] || ORI[591,0.00282,591] || ORI[612,0.00294,612] || ORI[622,0.00324,622] || ORI[627,0.00319,627] || ORI[632,0.00317,632] || ORI[676,0.00172,676] || ORI[704,0.00258,704] || ORI[707,0.00264,707] || ORI[720,0.00252,720] || ORI[741,0.00260,741] || ORI[757,0.00249,757] || ORI[761,0.00242,761] || ORI[774,0.00256,774] || ORI[792,0.00236,792] || ORI[796,0.00231,796] || ORI[802,0.00241,802] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[] || FF[];

